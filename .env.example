# ==============================================================================
# SETI Ellipsoid Detector - Production Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your confidential API keys & settings:
#   cp .env.example .env
# ==============================================================================

# --- Telegram Bot Alert Dispatcher ---
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# --- Search & Latency Parameters ---
OBSERVATION_LATENCY_PROFILE="bureaucratic"  # Options: automated_beacon, bureaucratic, generational
SEARCH_SHELL_TOLERANCE_DAYS=730.0            # Custom tolerance window in days (+/- days)
ANOMALY_THRESHOLD=0.60                       # Minimum IsolationForest score to trigger alert (0.0 to 1.0)
MAX_GAIA_MAGNITUDE=16.0                      # Gaia G-band magnitude limit

# --- Live Streaming & Daemon Options ---
POLL_INTERVAL_SECONDS=300                    # Interval between streaming iterations in seconds (5 min)
USE_MOCK_DATA=true                           # Set to false for live Gaia & Fink REST queries
